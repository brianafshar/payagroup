# Inner Caddy: serves the prerendered site on :80 and forwards data/SEO routes to the API container.
# TLS / domain is handled by your existing Caddy on the server (see README).
:80 {
	root * /srv
	encode zstd gzip

	@root path /
	redir @root /fa/ 301

	# uploads from the gym app, media, PDFs, sitemap
	@data path /api/* /media/* /files/* /sitemap.xml
	handle @data {
		request_body {
			max_size 3GB
		}
		reverse_proxy api:3000 {
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	# exercise pages are rendered by the API so search engines get title/description/video markup
	@exercise path_regexp exercise ^/(fa|en)/exercises/[0-9]+/?$
	handle @exercise {
		reverse_proxy api:3000
	}

	handle {
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@static path /brand/* /images/* /og.jpg /favicon*
		header @static Cache-Control "public, max-age=86400"
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
