{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://indow.ir/api"
      }
    },
    "apk-pushe": {
      "extends": "apk",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://indow.ir/api",
        "EXPO_PUBLIC_PUSH": "pushe"
      }
    }
  }
}
