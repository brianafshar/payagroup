# Copy to .env and adjust. Every value has a development default.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# Development (DJANGO_DEBUG=true) accepts any host, so a phone can reach `runserver 0.0.0.0:8000` by
# your computer's LAN IP. In production list your domains:
# DJANGO_ALLOWED_HOSTS=api.example.com
# SQLite by default; for PostgreSQL:
# DATABASE_URL=postgres://baseline:baseline@localhost:5432/baseline
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Base URL used in invite / password-reset links sent by email.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=indow <no-reply@indow.ir>
# SMTP. Unset = emails are only printed in the runserver terminal, nothing is delivered.
# Gmail: smtp.gmail.com / 587 / your address / a 16-character app password (myaccount.google.com/apppasswords).
# Test with: python manage.py send_test_email you@example.com
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587             # 465 = implicit SSL (EMAIL_USE_SSL is then on)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_TIMEOUT=20
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Production only (DJANGO_DEBUG=false):
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# Uploads (photos, logos, exercise videos, chat attachments) in S3-compatible storage.
# Unset = local media/ folder.
# S3_BUCKET=baseline-media
# S3_ENDPOINT_URL=https://s3.ir-thr-at1.arvanstorage.ir   # omit for AWS; R2: https://<account>.r2.cloudflarestorage.com
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC=false            # true = public-read objects, no signed URLs (use with a CDN)
# S3_CUSTOM_DOMAIN=          # e.g. cdn.example.com
# S3_URL_EXPIRE_SECONDS=3600
# Realtime chat across several server processes needs Redis (single process works without it).
# REDIS_URL=redis://localhost:6379/0
# Push notifications (athlete app) — optional: the app also lists every notification in-app.
#   log     print them in the runserver terminal (default when DJANGO_DEBUG=true)
#   expo    Expo push service (default in production). Expo blocks sanctioned regions (Iran): run the
#           API on a server abroad, or use pushe / webhook.
#   pushe   Pushe (pushe.co), Iranian service, Android; works from servers in Iran. The app must be
#           built with EXPO_PUBLIC_PUSH=pushe and PUSHE_MANIFEST_TOKEN (see the root README, "Pushe instead of Expo").
#   webhook POST {tokens, title, body, data} to your relay / a local push service adapter
#   off     nothing
# Test with: python manage.py send_test_push athlete@example.com
# PUSH_BACKEND=log
# EXPO_ACCESS_TOKEN=          # optional, Expo "enhanced push security"
# PUSH_WEBHOOK_URL=https://relay.example.com/push
# PUSH_WEBHOOK_SECRET=        # signs the body: X-Baseline-Signature: sha256=<HMAC-SHA256>
# PUSHE_API_TOKEN=            # pushe.co console → account settings → API token
# PUSHE_APP_ID=               # pushe.co console → the app's id
# Exercise library illustrations (RepDB flat style), downloaded once by install_exercise_library.
# Needs access to raw.githubusercontent.com; without it the bundled photos are used.
# EXERCISE_ILLUSTRATIONS=true
# EXERCISE_ILLUSTRATION_URL=https://raw.githubusercontent.com/RepDB/exercise-dataset/main/images/flat/{id}-{pose}.webp
