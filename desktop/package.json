{
  "name": "paya-group-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "PAYA Group — برنامه ویندوز مدیریت باشگاه",
  "author": "PAYA Group",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.payagroup.desktop",
    "productName": "PAYA Group",
    "directories": { "output": "dist-installer" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "server-dist/paya-server", "to": "server" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "language": "1065"
    }
  }
}
